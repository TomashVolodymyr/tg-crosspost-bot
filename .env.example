# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://crosspost:crosspost@localhost:5432/crosspost

# --- Admin bot ---
# Token from @BotFather
BOT_TOKEN=
# Comma-separated Telegram user ids allowed to manage the bot
ADMIN_IDS=

# --- Delivery ---
DELIVERY_POLL_INTERVAL_MS=3000
DELIVERY_BATCH_SIZE=20
MAX_ATTEMPTS=5
ALBUM_WAIT_MS=1500

# --- Telegram client API (optional, only for MtprotoSource) ---
# From https://my.telegram.org
TG_API_ID=
TG_API_HASH=
# Printed by `npm run session:login`
TG_SESSION=
MTPROTO_POLL_INTERVAL_S=60

# --- Facebook Page (optional) ---
FB_GRAPH_VERSION=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
